# Copie para .env e preencha. NUNCA faça commit do .env
GROQ_API_KEY=gsk_coloque_sua_chave_aqui

# Modelo Llama na Groq (confira os IDs vigentes em https://console.groq.com/docs/models)
GROQ_MODEL=llama-3.3-70b-versatile

# Número de ciclos por classe (artigo = 10)
N_RUNS=10

# Intervalo mínimo entre requisições (s). 2.5 s ~ 24 req/min (tier gratuito ~30 req/min)
REQUEST_INTERVAL_S=2.5

# Execução dos testes
TEST_TIMEOUT_S=60
N_WORKERS=4
