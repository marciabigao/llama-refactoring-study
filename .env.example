# Copie para .env e preencha. NUNCA faça commit do .env

# --- Configuração recomendada: Groq + Qwen3.8-27B (plano gratuito) ---
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_coloque_sua_chave_aqui
LLM_MODEL=qwen/qwen3.8-27b

# Ciclos por classe. O artigo usa 10; no plano gratuito (200K tokens/dia) 3 ciclos cabem em ~3 dias.
# Confirme com:  python scripts/02_generate_refactorings.py --plan --days 3
N_RUNS=3

# Intervalo entre requisições (s). 12 s respeita 8.000 tokens/min do plano gratuito do Qwen na Groq.
REQUEST_INTERVAL_S=12

# Cotas diárias do seu plano (só usadas pelo --plan). Ajuste se mudar de plano/modelo.
DAILY_TOKEN_QUOTA=200000
DAILY_REQUEST_QUOTA=1000

# Qwen3.8 é modelo de raciocínio. Se as respostas vierem com muitos tokens de "pensamento"
# (veja usage.reasoning_tokens em results/<modelo>/raw/*.json), descomente:
# LLM_REASONING_EFFORT=none

# --- Execução dos testes ---
TEST_TIMEOUT_S=60
N_WORKERS=4

# --- Alternativas (troque LLM_PROVIDER, a chave e LLM_MODEL) ---
# LLM_PROVIDER=sambanova   SAMBANOVA_API_KEY=...   LLM_MODEL=Meta-Llama-3.3-70B-Instruct
# LLM_PROVIDER=fireworks   FIREWORKS_API_KEY=...   LLM_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
