# Copie para .env e preencha. NUNCA faça commit do .env

# Provedor: fireworks (padrão) ou groq
LLM_PROVIDER=fireworks
FIREWORKS_API_KEY=fw_coloque_sua_chave_aqui
# GROQ_API_KEY=gsk_...   (só se usar o provedor groq)

# ID do modelo EXATAMENTE como na API do provedor (no Fireworks tem o prefixo accounts/fireworks/models/)
LLM_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# Número de ciclos por classe (artigo = 10)
N_RUNS=10

# Intervalo mínimo entre requisições (s)
REQUEST_INTERVAL_S=0.5

# Execução dos testes
TEST_TIMEOUT_S=60
N_WORKERS=4
